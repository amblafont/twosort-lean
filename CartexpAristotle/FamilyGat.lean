import CartexpAristotle.TwoSortification
import CartexpAristotle.BiInitialInduction
import Mathlib.CategoryTheory.Limits.Constructions.LimitsOfProductsAndEqualizers

/-!
# Family GATs and soundness of two-sortification

In any `Lexp`-category `(C, p : Y ⟶ X)`, we define the predicate `SliceExp.IsFamilyGat p` on objects
of the slice category `C / P X` (`Over (sZ p)`), inductively generated by the three rules of
[Paper, §3.2]:
1. `P X` (with the identity morphism `𝟙 (P X)`) is a family GAT (`IsFamilyGat.px`);
2. pulling back a family GAT along `P^n p : P^n Y ⟶ P^n X` yields a family GAT
   (`IsFamilyGat.pullback`);
3. taking the equaliser of two morphisms `σ, δ : Γ ⟶ P^n Y` satisfying `σ ≫ P^n p = δ ≫ P^n p`
   yields a family GAT (`IsFamilyGat.equalizer`).

We prove [Paper, §3.2, Prop. `prop:family-gats`] (detailed in [Paper, App. A.2]):
* the domain and codomain of the chosen exponentiable morphism `p̲ : Y̲ ⟶ X̲` of `C / P X` are
  family GATs (`IsFamilyGat.dom`, `IsFamilyGat.cod`);
* family GATs are closed under isomorphisms (`IsFamilyGat.of_iso`), the terminal object
  (`IsFamilyGat.terminal`), pullbacks (`IsFamilyGat.of_isPullback`), equalisers
  (`IsFamilyGat.of_isLimit_fork`), and all finite limits (`IsFamilyGat.of_isLimit_finite`);
* family GATs are closed under pushforwards along `p̲` (`IsFamilyGat.exp`).

Consequently, the full subcategory of `C / P X` spanned by family GATs inherits the `Lexp`-structure
of `Φ A = C / P X` (`Lexp.isFamilyGat_inductive`, `Lexp.FamGat`). By bi-initiality of `FinGat`, we
obtain the soundness corollary ([Paper, §3.2, Corollary after Prop. `prop:family-gats`]): the image
of any GAT under the two-sortification functor is a family GAT (`Lexp.twoSortification_isFamilyGat`,
`Lexp.exists_isFamilyGat_iso_twoSortification`).

## References

* [Paper, §3.2, Def. of family GATs]: `SliceExp.IsFamilyGat`, `Lexp.IsFamilyGat`.
* [Paper, §3.2, Prop. `prop:family-gats`] and [Paper, App. A.2]: `SliceExp.IsFamilyGat.dom`,
  `SliceExp.IsFamilyGat.cod`, `SliceExp.IsFamilyGat.of_isPullback`,
  `SliceExp.IsFamilyGat.of_isLimit_fork`, `SliceExp.IsFamilyGat.of_isLimit_finite`,
  `SliceExp.IsFamilyGat.exp`, `Lexp.isFamilyGat_inductive`.
* [Paper, §3.2, Corollary after Prop. `prop:family-gats`]:
  `Lexp.exists_isFamilyGat_iso_twoSortification`, `Lexp.twoSortification_isFamilyGat`.
-/

open CategoryTheory Limits

universe v u

namespace SliceExp

variable {C : Type u} [Category.{v} C] {X Y : C} (u : Y ⟶ X) [IsExpArr u]

/-- The chosen universal `Data` for `u` at an object `c : C`. -/
noncomputable abbrev expData (c : C) : Data u c := IsExpArr.isExpArrowData c

noncomputable instance expData_universal (c : C) : Universal (expData u c) :=
  IsExpArr.isExpArrow c

/-- The pushforward endofunctor `P : C ⥤ C` associated with the exponentiable morphism `u : Y ⟶ X`. -/
noncomputable def PFunc : C ⥤ C where
  obj c := (expData u c).P
  map f := canonical_mor' f (expData u _) (expData u _)
  map_id c := canonical_mor'_id (expData u c)
  map_comp f g := (canonical_mor'_comp f g (expData u _) (expData u _) (expData u _)).symm

/-- The `n`-fold iterate `P^n : C ⥤ C` of the pushforward endofunctor `P`. -/
noncomputable def iterP : ℕ → C ⥤ C
  | 0 => 𝟭 C
  | n + 1 => iterP n ⋙ PFunc u

@[simp] lemma iterP_zero : iterP u 0 = 𝟭 C := rfl

@[simp] lemma iterP_succ (n : ℕ) : iterP u (n + 1) = iterP u n ⋙ PFunc u := rfl

lemma PFunc_map_pi {c c' : C} (f : c ⟶ c') :
    (expData u c).pi = (PFunc u).map f ≫ (expData u c').pi :=
  Universal.isSlice ((expData u c).epsilon ≫ f)

lemma PFunc_map_eps {c c' : C} (f : c ⟶ c') :
    FBF_on_mor (expData u c') (expData u c).Pbk (PFunc_map_pi u f) ≫ (expData u c').epsilon =
      (expData u c).epsilon ≫ f :=
  (Universal.comm ((expData u c).epsilon ≫ f)).symm

/-- Transpose of a morphism `m : d ⟶ P c` over `X` to a morphism `K.pullback ⟶ c`. -/
noncomputable def adjUncurry {c d : C} {h : d ⟶ X} (K : ChosenPullback u h)
    (m : d ⟶ (PFunc u).obj c) (hm : h = m ≫ (expData u c).pi) : K.pullback ⟶ c :=
  FBF_on_mor (expData u c) K hm ≫ (expData u c).epsilon

lemma adjUncurry_comp_PFunc_map {c c' d : C} {h : d ⟶ X} (K : ChosenPullback u h)
    (m : d ⟶ (PFunc u).obj c) (hm : h = m ≫ (expData u c).pi) (f : c ⟶ c')
    (hmf : h = (m ≫ (PFunc u).map f) ≫ (expData u c').pi) :
    adjUncurry u K (m ≫ (PFunc u).map f) hmf = adjUncurry u K m hm ≫ f := by
  dsimp [adjUncurry]
  have L := FBF_on_mor_map (expData u c') K (expData u c).Pbk m (FBF_on_mor (expData u c) K hm)
    (FBF_on_mor_fst _ _ _) (FBF_on_mor_snd _ _ _) hmf (PFunc_map_pi u f) rfl
  rw [L, Category.assoc, PFunc_map_eps, Category.assoc]

lemma adjUncurry_mor {c d : C} {h : d ⟶ X} (K : ChosenPullback u h) (g : K.pullback ⟶ c) :
    adjUncurry u K (Universal.mor (data := expData u c) (Kuf := K) g)
      (Universal.isSlice (data := expData u c) (Kuf := K) g) = g :=
  (Universal.comm (data := expData u c) (Kuf := K) g).symm

lemma adjUncurry_inj {c d : C} {h : d ⟶ X} (K : ChosenPullback u h)
    {m₁ m₂ : d ⟶ (PFunc u).obj c} (hm₁ : h = m₁ ≫ (expData u c).pi)
    (hm₂ : h = m₂ ≫ (expData u c).pi)
    (heq : adjUncurry u K m₁ hm₁ = adjUncurry u K m₂ hm₂) : m₁ = m₂ :=
  Universal.uniq (data := expData u c) K hm₁ hm₂ heq

lemma adjUncurry_congr {c d : C} {h : d ⟶ X} (K : ChosenPullback u h)
    {m₁ m₂ : d ⟶ (PFunc u).obj c} (hm : m₁ = m₂) (hm₁ : h = m₁ ≫ (expData u c).pi)
    (hm₂ : h = m₂ ≫ (expData u c).pi) :
    adjUncurry u K m₁ hm₁ = adjUncurry u K m₂ hm₂ := by
  subst hm
  rfl

/-- An isomorphism `i : E ⟶ A` is the equaliser of `σ` and `σ`. -/
noncomputable def isLimitForkOfIsIso {E A B : C} (i : E ⟶ A) [IsIso i] (σ : A ⟶ B) :
    IsLimit (Fork.ofι i (rfl : i ≫ σ = i ≫ σ)) :=
  Fork.IsLimit.mk' _ fun s =>
    ⟨s.ι ≫ inv i, by simp, fun {m} hm => by
      change m ≫ i = s.ι at hm
      rw [← hm, Category.assoc, IsIso.hom_inv_id, Category.comp_id]⟩

/-- Pulling back an equaliser fork `i : E ⟶ A` of `σ, δ : A ⟶ B` along `r : A' ⟶ A` gives an
equaliser fork of `r ≫ σ` and `r ≫ δ`. -/
noncomputable def isLimitForkOfIsPullback {E' E A' A B : C} {p : E' ⟶ E} {q : E' ⟶ A'}
    {i : E ⟶ A} {r : A' ⟶ A} {σ δ : A ⟶ B} (w : i ≫ σ = i ≫ δ)
    (heq : IsLimit (Fork.ofι i w)) (hpb : IsPullback p q i r) :
    IsLimit (Fork.ofι q (show q ≫ (r ≫ σ) = q ≫ (r ≫ δ) by
      rw [← Category.assoc, ← Category.assoc, ← hpb.w, Category.assoc, w, ← Category.assoc])) := by
  refine Fork.IsLimit.mk' _ fun s => ?_
  have hcond : (s.ι ≫ r) ≫ σ = (s.ι ≫ r) ≫ δ := by
    simpa [Category.assoc] using s.condition
  let ⟨l, hl⟩ := Fork.IsLimit.lift' heq (s.ι ≫ r) hcond
  change l ≫ i = s.ι ≫ r at hl
  refine ⟨hpb.lift l s.ι hl, hpb.lift_snd _ _ _, fun {m} hm => ?_⟩
  change m ≫ q = s.ι at hm
  apply hpb.hom_ext
  · rw [IsPullback.lift_fst]
    apply Fork.IsLimit.hom_ext heq
    let m' : s.pt ⟶ E' := m
    let l' : s.pt ⟶ E := l
    change (m' ≫ p) ≫ i = l' ≫ i
    rw [Category.assoc, hpb.w, ← Category.assoc, show m' ≫ q = s.ι from hm, hl]
  · rw [IsPullback.lift_snd, hm]

section Limits

variable [HasPullbacks C]

/-- The pushforward endofunctor `P` preserves pullback squares. -/
theorem PFunc_map_isPullback {W X₁ X₂ S : C} {fst : W ⟶ X₁} {snd : W ⟶ X₂}
    {f : X₁ ⟶ S} {g : X₂ ⟶ S} (hpb : IsPullback fst snd f g) :
    IsPullback ((PFunc u).map fst) ((PFunc u).map snd) ((PFunc u).map f) ((PFunc u).map g) := by
  refine ⟨⟨by rw [← Functor.map_comp, ← Functor.map_comp, hpb.w]⟩, ⟨PullbackCone.isLimitAux' _ ?_⟩⟩
  intro s
  let h : s.pt ⟶ X := s.fst ≫ (expData u X₁).pi
  have hh₁ : h = s.fst ≫ (expData u X₁).pi := rfl
  have hh₂ : h = s.snd ≫ (expData u X₂).pi := by
    dsimp [h]
    rw [PFunc_map_pi u f, ← Category.assoc, s.condition, Category.assoc, ← PFunc_map_pi u g]
  have hhS₁ : h = (s.fst ≫ (PFunc u).map f) ≫ (expData u S).pi := by
    rw [Category.assoc, ← PFunc_map_pi u f]
  have hhS₂ : h = (s.snd ≫ (PFunc u).map g) ≫ (expData u S).pi := by
    rw [Category.assoc, ← PFunc_map_pi u g, ← hh₂]
  let K : ChosenPullback u h := chosenOfIsPullback (IsPullback.of_hasPullback u h)
  have hcond : adjUncurry u K s.fst hh₁ ≫ f = adjUncurry u K s.snd hh₂ ≫ g := by
    rw [← adjUncurry_comp_PFunc_map u K s.fst hh₁ f hhS₁,
      ← adjUncurry_comp_PFunc_map u K s.snd hh₂ g hhS₂]
    exact adjUncurry_congr u K s.condition hhS₁ hhS₂
  let l : K.pullback ⟶ W := hpb.lift (adjUncurry u K s.fst hh₁) (adjUncurry u K s.snd hh₂) hcond
  let m : s.pt ⟶ (PFunc u).obj W := Universal.mor (data := expData u W) (Kuf := K) l
  have hm : h = m ≫ (expData u W).pi := Universal.isSlice (data := expData u W) (Kuf := K) l
  have hm₁ : m ≫ (PFunc u).map fst = s.fst := by
    refine adjUncurry_inj u K (by rw [Category.assoc, ← PFunc_map_pi u fst, ← hm]) hh₁ ?_
    rw [adjUncurry_comp_PFunc_map u K m hm fst, adjUncurry_mor, IsPullback.lift_fst]
  have hm₂ : m ≫ (PFunc u).map snd = s.snd := by
    refine adjUncurry_inj u K (by rw [Category.assoc, ← PFunc_map_pi u snd, ← hm]) hh₂ ?_
    rw [adjUncurry_comp_PFunc_map u K m hm snd, adjUncurry_mor, IsPullback.lift_snd]
  refine ⟨m, hm₁, hm₂, fun {m'} hm₁' hm₂' => ?_⟩
  change m' ≫ (PFunc u).map fst = s.fst at hm₁'
  change m' ≫ (PFunc u).map snd = s.snd at hm₂'
  have hm' : h = m' ≫ (expData u W).pi := by
    rw [PFunc_map_pi u fst, ← Category.assoc, hm₁']
  refine adjUncurry_inj u K hm' hm ?_
  rw [adjUncurry_mor]
  apply hpb.hom_ext
  · rw [IsPullback.lift_fst, ← adjUncurry_comp_PFunc_map u K m' hm' fst (by rw [hm₁']),
      adjUncurry_congr u K hm₁' _ hh₁]
  · rw [IsPullback.lift_snd, ← adjUncurry_comp_PFunc_map u K m' hm' snd (by rw [hm₂']; exact hh₂),
      adjUncurry_congr u K hm₂' _ hh₂]

/-- The pushforward endofunctor `P` preserves equalisers. -/
noncomputable def PFunc_map_isLimit_fork {E A B : C} {ι : E ⟶ A} {σ δ : A ⟶ B}
    (w : ι ≫ σ = ι ≫ δ) (heq : IsLimit (Fork.ofι ι w)) :
    IsLimit (Fork.ofι ((PFunc u).map ι)
      (show (PFunc u).map ι ≫ (PFunc u).map σ = (PFunc u).map ι ≫ (PFunc u).map δ by
        rw [← Functor.map_comp, ← Functor.map_comp, w])) := by
  refine Fork.IsLimit.mk' _ fun s => ?_
  let h : s.pt ⟶ X := s.ι ≫ (expData u A).pi
  let K : ChosenPullback u h := chosenOfIsPullback (IsPullback.of_hasPullback u h)
  have hσ : h = (s.ι ≫ (PFunc u).map σ) ≫ (expData u B).pi := by
    rw [Category.assoc, ← PFunc_map_pi u σ]
  have hδ : h = (s.ι ≫ (PFunc u).map δ) ≫ (expData u B).pi := by
    rw [Category.assoc, ← PFunc_map_pi u δ]
  have hcond : adjUncurry u K s.ι rfl ≫ σ = adjUncurry u K s.ι rfl ≫ δ := by
    rw [← adjUncurry_comp_PFunc_map u K s.ι rfl σ hσ,
      ← adjUncurry_comp_PFunc_map u K s.ι rfl δ hδ]
    exact adjUncurry_congr u K s.condition hσ hδ
  let ⟨l, hl⟩ := Fork.IsLimit.lift' heq (adjUncurry u K s.ι rfl) hcond
  change l ≫ ι = adjUncurry u K s.ι rfl at hl
  let m : s.pt ⟶ (PFunc u).obj E := Universal.mor (data := expData u E) (Kuf := K) l
  have hm : h = m ≫ (expData u E).pi := Universal.isSlice (data := expData u E) (Kuf := K) l
  have hfac : m ≫ (PFunc u).map ι = s.ι := by
    refine adjUncurry_inj u K (by rw [Category.assoc, ← PFunc_map_pi u ι, ← hm]) rfl ?_
    rw [adjUncurry_comp_PFunc_map u K m hm ι, adjUncurry_mor, hl]
  refine ⟨m, hfac, fun {m'} hm' => ?_⟩
  change m' ≫ (PFunc u).map ι = s.ι at hm'
  have hm'_pi : h = m' ≫ (expData u E).pi := by
    rw [PFunc_map_pi u ι, ← Category.assoc, hm']
  refine adjUncurry_inj u K hm'_pi hm ?_
  rw [adjUncurry_mor]
  apply Fork.IsLimit.hom_ext heq
  change adjUncurry u K m' hm'_pi ≫ ι = l ≫ ι
  rw [hl, ← adjUncurry_comp_PFunc_map u K m' hm'_pi ι (by rw [hm']),
    adjUncurry_congr u K hm' _ rfl]

/-- In a category with pullbacks, any two morphisms `f₁, f₂ : A ⟶ B` that agree after composing
with some `q : B ⟶ S` have an equaliser. -/
lemma exists_isLimit_fork_of_comp_eq {A B S : C} (f₁ f₂ : A ⟶ B) (q : B ⟶ S)
    (hq : f₁ ≫ q = f₂ ≫ q) :
    ∃ (E : C) (ι : E ⟶ A) (w : ι ≫ f₁ = ι ≫ f₂), Nonempty (IsLimit (Fork.ofι ι w)) := by
  let l : A ⟶ pullback q q := pullback.lift f₁ f₂ hq
  let d : B ⟶ pullback q q := pullback.lift (𝟙 B) (𝟙 B) rfl
  let E : C := pullback l d
  let ι : E ⟶ A := pullback.fst l d
  have h₁ : ι ≫ f₁ = pullback.snd l d := by
    have := pullback.condition (f := l) (g := d) =≫ pullback.fst q q
    simpa [ι, l, d] using this
  have h₂ : ι ≫ f₂ = pullback.snd l d := by
    have := pullback.condition (f := l) (g := d) =≫ pullback.snd q q
    simpa [ι, l, d] using this
  have w : ι ≫ f₁ = ι ≫ f₂ := h₁.trans h₂.symm
  refine ⟨E, ι, w, ⟨Fork.IsLimit.mk' _ fun s => ?_⟩⟩
  have hs : s.ι ≫ l = (s.ι ≫ f₁) ≫ d := by
    apply pullback.hom_ext
    · simp [l, d]
    · simp [l, d, s.condition]
  refine ⟨pullback.lift s.ι (s.ι ≫ f₁) hs, pullback.lift_fst _ _ _, fun {m} hm => ?_⟩
  let m' : s.pt ⟶ E := m
  have hm' : m' ≫ ι = s.ι := hm
  apply pullback.hom_ext
  · rw [pullback.lift_fst]
    exact hm'
  · rw [pullback.lift_snd, ← hm', Category.assoc, h₁]

/-- **Family GATs** in the slice category `C / P X` (`Over (sZ u)`), generated by the three rules
of [Paper, §3.2]:
1. `P X` (with the identity morphism to `P X`) is a family GAT (`px`);
2. pulling back a family GAT along `P^n u : P^n Y ⟶ P^n X` yields a family GAT (`pullback`);
3. taking the equaliser of two morphisms `σ, δ : Γ ⟶ P^n Y` satisfying `σ ≫ P^n u = δ ≫ P^n u`
   yields a family GAT (`equalizer`).

[Paper, §3.2, Def. of family GATs]. -/
inductive IsFamilyGat : Over (sZ u) → Prop where
  | px : IsFamilyGat (Over.mk (𝟙 (sZ u)))
  | pullback {Γ Δ : Over (sZ u)} (hΓ : IsFamilyGat Γ) (n : ℕ)
      (f : Δ ⟶ Γ) (g : Δ.left ⟶ (iterP u n).obj Y) (h : Γ.left ⟶ (iterP u n).obj X)
      (hpb : IsPullback g f.left ((iterP u n).map u) h) : IsFamilyGat Δ
  | equalizer {Γ Δ : Over (sZ u)} (hΓ : IsFamilyGat Γ) (n : ℕ)
      (f : Δ ⟶ Γ) (σ δ : Γ.left ⟶ (iterP u n).obj Y)
      (hσδ : σ ≫ (iterP u n).map u = δ ≫ (iterP u n).map u)
      (w : f.left ≫ σ = f.left ≫ δ)
      (heq : IsLimit (Fork.ofι f.left w)) : IsFamilyGat Δ

namespace IsFamilyGat

variable {u}

/-- Family GATs are closed under isomorphisms in `Over (sZ u)`. -/
theorem of_iso {Γ Δ : Over (sZ u)} (e : Γ ≅ Δ) (hΓ : IsFamilyGat u Γ) : IsFamilyGat u Δ := by
  let x : Γ.left ⟶ X := Γ.hom ≫ (sX u).pi
  let K : ChosenPullback u x := chosenOfIsPullback (IsPullback.of_hasPullback u x)
  let σ : Γ.left ⟶ (iterP u 1).obj Y :=
    Universal.mor (data := expData u Y) (Kuf := K) K.p₁
  haveI : IsIso e.inv.left := (Over.forget (sZ u)).map_isIso e.inv
  exact IsFamilyGat.equalizer hΓ 1 e.inv σ σ rfl rfl (isLimitForkOfIsIso e.inv.left σ)

/-- Any terminal object of `Over (sZ u)` is a family GAT. -/
theorem of_isTerminal {T : Over (sZ u)} (hT : IsTerminal T) : IsFamilyGat u T :=
  of_iso (Over.mkIdTerminal.uniqueUpToIso hT) IsFamilyGat.px

/-- The chosen terminal object `⊤_ (Over (sZ u))` is a family GAT. -/
theorem terminal : IsFamilyGat u (⊤_ (Over (sZ u))) :=
  of_isTerminal terminalIsTerminal

omit [HasPullbacks C] in
/-- `(A : U)_Fam` (`Over.mk (sW u)`, the codomain of `sArr u`) is a family GAT.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
theorem cod : IsFamilyGat u (Over.mk (sW u)) :=
  IsFamilyGat.pullback IsFamilyGat.px 0
    (Over.homMk (sW u) (by simp)) (sX u).Pbk.p₁ (sX u).pi (sX u).Pbk.isPullback

/-- `(A : U, a : El A)_Fam` (`Over.mk (su' u ≫ sW u)`, the domain of `sArr u`) is a family GAT.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
theorem dom : IsFamilyGat u (Over.mk (su' u ≫ sW u)) :=
  IsFamilyGat.pullback IsFamilyGat.cod 0
    (sArr u) (pullback.fst u (sE u)) (sE u) (shpb u)

/-- Auxiliary induction for closure of family GATs under pushforwards along `sArr u`: any pullback
of `P(c.hom) : P c ⟶ P (P X)` along `τ : X̲ ⟶ P (P X)` is a family GAT whenever `c` is.

[Paper, App. A.2, proof of Prop. `prop:family-gats`]. -/
theorem exp_aux {c : Over (sZ u)} (hc : IsFamilyGat u c) {W : Over (sZ u)}
    (ω : W.left ⟶ (PFunc u).obj c.left) (π : W ⟶ Over.mk (sW u))
    (hpb : IsPullback ω π.left ((PFunc u).map c.hom) (sτ u)) : IsFamilyGat u W := by
  induction hc generalizing W with
  | px =>
    have h_id : (PFunc u).map (Over.mk (𝟙 (sZ u))).hom = 𝟙 ((PFunc u).obj (sZ u)) :=
      (PFunc u).map_id (sZ u)
    have hpb' : IsPullback ω π.left (𝟙 _) (sτ u) := h_id ▸ hpb
    haveI : IsIso ((Over.forget (sZ u)).map π) := hpb'.isIso_snd_of_isIso
    haveI : IsIso π := isIso_of_reflects_iso π (Over.forget (sZ u))
    exact of_iso (asIso π).symm cod
  | @pullback Γ Δ hΓ n f g h hpb_step ih =>
    let W_Γ : Over (sZ u) := (sOverData u Γ).P
    let ω_Γ : W_Γ.left ⟶ (PFunc u).obj Γ.left := sω u Γ
    let π_Γ : W_Γ ⟶ Over.mk (sW u) := Over.homMk (sπ u Γ) rfl
    have hpb_Γ : IsPullback ω_Γ π_Γ.left ((PFunc u).map Γ.hom) (sτ u) :=
      IsPullback.of_hasPullback (sPq u Γ) (sτ u)
    have hW_Γ : IsFamilyGat u W_Γ := ih ω_Γ π_Γ hpb_Γ
    have hcomm : (ω ≫ (PFunc u).map f.left) ≫ (PFunc u).map Γ.hom = π.left ≫ sτ u := by
      rw [Category.assoc, ← (PFunc u).map_comp, Over.w f]
      exact hpb.w
    let f' : W.left ⟶ W_Γ.left := hpb_Γ.lift (ω ≫ (PFunc u).map f.left) π.left hcomm
    have hf'_ω : f' ≫ ω_Γ = ω ≫ (PFunc u).map f.left := hpb_Γ.lift_fst _ _ _
    have hf'_π : f' ≫ π_Γ.left = π.left := hpb_Γ.lift_snd _ _ _
    have hf'_over : f' ≫ W_Γ.hom = W.hom := by
      change f' ≫ π_Γ.left ≫ sW u = W.hom
      rw [← Category.assoc, hf'_π]
      exact Over.w π
    have hpb_top : IsPullback ω f' ((PFunc u).map f.left) ω_Γ := by
      refine IsPullback.of_bot ?_ hf'_ω.symm hpb_Γ
      rw [hf'_π, ← (PFunc u).map_comp, Over.w f]
      exact hpb
    have hpb_P : IsPullback ((PFunc u).map g) ((PFunc u).map f.left)
        ((iterP u (n + 1)).map u) ((PFunc u).map h) :=
      PFunc_map_isPullback u hpb_step
    exact IsFamilyGat.pullback hW_Γ (n + 1) (Over.homMk f' hf'_over)
      (ω ≫ (PFunc u).map g) (ω_Γ ≫ (PFunc u).map h) (hpb_top.paste_horiz hpb_P)
  | @equalizer Γ Δ hΓ n f σ δ hσδ w heq ih =>
    let W_Γ : Over (sZ u) := (sOverData u Γ).P
    let ω_Γ : W_Γ.left ⟶ (PFunc u).obj Γ.left := sω u Γ
    let π_Γ : W_Γ ⟶ Over.mk (sW u) := Over.homMk (sπ u Γ) rfl
    have hpb_Γ : IsPullback ω_Γ π_Γ.left ((PFunc u).map Γ.hom) (sτ u) :=
      IsPullback.of_hasPullback (sPq u Γ) (sτ u)
    have hW_Γ : IsFamilyGat u W_Γ := ih ω_Γ π_Γ hpb_Γ
    have hcomm : (ω ≫ (PFunc u).map f.left) ≫ (PFunc u).map Γ.hom = π.left ≫ sτ u := by
      rw [Category.assoc, ← (PFunc u).map_comp, Over.w f]
      exact hpb.w
    let f' : W.left ⟶ W_Γ.left := hpb_Γ.lift (ω ≫ (PFunc u).map f.left) π.left hcomm
    have hf'_ω : f' ≫ ω_Γ = ω ≫ (PFunc u).map f.left := hpb_Γ.lift_fst _ _ _
    have hf'_π : f' ≫ π_Γ.left = π.left := hpb_Γ.lift_snd _ _ _
    have hf'_over : f' ≫ W_Γ.hom = W.hom := by
      change f' ≫ π_Γ.left ≫ sW u = W.hom
      rw [← Category.assoc, hf'_π]
      exact Over.w π
    have hpb_top : IsPullback ω f' ((PFunc u).map f.left) ω_Γ := by
      refine IsPullback.of_bot ?_ hf'_ω.symm hpb_Γ
      rw [hf'_π, ← (PFunc u).map_comp, Over.w f]
      exact hpb
    have hσδ' : (ω_Γ ≫ (PFunc u).map σ) ≫ (iterP u (n + 1)).map u =
        (ω_Γ ≫ (PFunc u).map δ) ≫ (iterP u (n + 1)).map u := by
      change (ω_Γ ≫ (PFunc u).map σ) ≫ (PFunc u).map ((iterP u n).map u) =
        (ω_Γ ≫ (PFunc u).map δ) ≫ (PFunc u).map ((iterP u n).map u)
      rw [Category.assoc, Category.assoc, ← (PFunc u).map_comp, ← (PFunc u).map_comp, hσδ]
    exact IsFamilyGat.equalizer hW_Γ (n + 1) (Over.homMk f' hf'_over)
      (ω_Γ ≫ (PFunc u).map σ) (ω_Γ ≫ (PFunc u).map δ) hσδ' _
      (isLimitForkOfIsPullback _ (PFunc_map_isLimit_fork u w heq) hpb_top)

/-- Family GATs are closed under pushforwards along `sArr u` in `Over (sZ u)`.

[Paper, §3.2, Prop. `prop:family-gats`] and [Paper, App. A.2]. -/
theorem exp {c : Over (sZ u)} (hc : IsFamilyGat u c) :
    IsFamilyGat u (sOverData u c).P :=
  exp_aux hc (sω u c) (Over.homMk (sπ u c) rfl) (IsPullback.of_hasPullback (sPq u c) (sτ u))

/-- Family GATs are closed under binary products in `Over (sZ u)` (pullbacks over `P X` in `C`). -/
theorem prod_over {Γ₁ Γ₂ : Over (sZ u)} (hΓ₁ : IsFamilyGat u Γ₁) (hΓ₂ : IsFamilyGat u Γ₂)
    {W : Over (sZ u)} (fst : W ⟶ Γ₁) (snd : W ⟶ Γ₂)
    (hpb : IsPullback fst.left snd.left Γ₁.hom Γ₂.hom) : IsFamilyGat u W := by
  induction hΓ₂ generalizing W with
  | px =>
    haveI : IsIso (Over.mk (𝟙 (sZ u))).hom := inferInstanceAs (IsIso (𝟙 (sZ u)))
    haveI : IsIso ((Over.forget (sZ u)).map fst) := hpb.isIso_fst_of_isIso
    haveI : IsIso fst := isIso_of_reflects_iso fst (Over.forget (sZ u))
    exact of_iso (asIso fst).symm hΓ₁
  | @pullback Γ Δ hΓ n f g h hpb_step ih =>
    let W_Γ : Over (sZ u) := Over.mk (pullback.fst Γ₁.hom Γ.hom ≫ Γ₁.hom)
    let fst_Γ : W_Γ ⟶ Γ₁ := Over.homMk (pullback.fst Γ₁.hom Γ.hom) rfl
    let snd_Γ : W_Γ ⟶ Γ := Over.homMk (pullback.snd Γ₁.hom Γ.hom) pullback.condition.symm
    have hpb_Γ : IsPullback fst_Γ.left snd_Γ.left Γ₁.hom Γ.hom :=
      IsPullback.of_hasPullback Γ₁.hom Γ.hom
    have hW_Γ : IsFamilyGat u W_Γ := ih fst_Γ snd_Γ hpb_Γ
    have hcomm : fst.left ≫ Γ₁.hom = (snd.left ≫ f.left) ≫ Γ.hom := by
      rw [Category.assoc, Over.w f, hpb.w]
    let f' : W.left ⟶ W_Γ.left := hpb_Γ.lift fst.left (snd.left ≫ f.left) hcomm
    have hf'_fst : f' ≫ fst_Γ.left = fst.left := hpb_Γ.lift_fst _ _ _
    have hf'_snd : f' ≫ snd_Γ.left = snd.left ≫ f.left := hpb_Γ.lift_snd _ _ _
    have hf'_over : f' ≫ W_Γ.hom = W.hom := by
      change f' ≫ fst_Γ.left ≫ Γ₁.hom = W.hom
      rw [← Category.assoc, hf'_fst]
      exact Over.w fst
    have hpb_top : IsPullback snd.left f' f.left snd_Γ.left := by
      refine IsPullback.of_bot ?_ hf'_snd.symm hpb_Γ.flip
      rw [hf'_fst, Over.w f]
      exact hpb.flip
    exact IsFamilyGat.pullback hW_Γ n (Over.homMk f' hf'_over)
      (snd.left ≫ g) (snd_Γ.left ≫ h) (hpb_top.paste_horiz hpb_step)
  | @equalizer Γ Δ hΓ n f σ δ hσδ w heq ih =>
    let W_Γ : Over (sZ u) := Over.mk (pullback.fst Γ₁.hom Γ.hom ≫ Γ₁.hom)
    let fst_Γ : W_Γ ⟶ Γ₁ := Over.homMk (pullback.fst Γ₁.hom Γ.hom) rfl
    let snd_Γ : W_Γ ⟶ Γ := Over.homMk (pullback.snd Γ₁.hom Γ.hom) pullback.condition.symm
    have hpb_Γ : IsPullback fst_Γ.left snd_Γ.left Γ₁.hom Γ.hom :=
      IsPullback.of_hasPullback Γ₁.hom Γ.hom
    have hW_Γ : IsFamilyGat u W_Γ := ih fst_Γ snd_Γ hpb_Γ
    have hcomm : fst.left ≫ Γ₁.hom = (snd.left ≫ f.left) ≫ Γ.hom := by
      rw [Category.assoc, Over.w f, hpb.w]
    let f' : W.left ⟶ W_Γ.left := hpb_Γ.lift fst.left (snd.left ≫ f.left) hcomm
    have hf'_fst : f' ≫ fst_Γ.left = fst.left := hpb_Γ.lift_fst _ _ _
    have hf'_snd : f' ≫ snd_Γ.left = snd.left ≫ f.left := hpb_Γ.lift_snd _ _ _
    have hf'_over : f' ≫ W_Γ.hom = W.hom := by
      change f' ≫ fst_Γ.left ≫ Γ₁.hom = W.hom
      rw [← Category.assoc, hf'_fst]
      exact Over.w fst
    have hpb_top : IsPullback snd.left f' f.left snd_Γ.left := by
      refine IsPullback.of_bot ?_ hf'_snd.symm hpb_Γ.flip
      rw [hf'_fst, Over.w f]
      exact hpb.flip
    have hσδ' : (snd_Γ.left ≫ σ) ≫ (iterP u n).map u =
        (snd_Γ.left ≫ δ) ≫ (iterP u n).map u := by
      rw [Category.assoc, Category.assoc, hσδ]
    exact IsFamilyGat.equalizer hW_Γ n (Over.homMk f' hf'_over)
      (snd_Γ.left ≫ σ) (snd_Γ.left ≫ δ) hσδ' _
      (isLimitForkOfIsPullback w heq hpb_top)

/-- Family GATs are closed under equalisers of morphisms between family GATs in `Over (sZ u)`. -/
theorem of_isLimit_fork_left {Γ₀ : Over (sZ u)} (hΓ₀ : IsFamilyGat u Γ₀)
    {Γ Δ : Over (sZ u)} (hΓ : IsFamilyGat u Γ) (f₁ f₂ : Γ ⟶ Γ₀) (e : Δ ⟶ Γ)
    (w : e.left ≫ f₁.left = e.left ≫ f₂.left) (heq : IsLimit (Fork.ofι e.left w)) :
    IsFamilyGat u Δ := by
  induction hΓ₀ generalizing Γ Δ with
  | px =>
    have hf : f₁.left = f₂.left := congrArg CommaMorphism.left (Over.mkIdTerminal.hom_ext f₁ f₂)
    let ⟨l, hl⟩ := Fork.IsLimit.lift' heq (𝟙 Γ.left) (by rw [hf])
    change l ≫ e.left = 𝟙 Γ.left at hl
    have hel : e.left ≫ l = 𝟙 Δ.left := by
      apply Fork.IsLimit.hom_ext heq
      change (e.left ≫ l) ≫ e.left = 𝟙 Δ.left ≫ e.left
      rw [Category.assoc, hl, Category.comp_id, Category.id_comp]
    haveI : IsIso ((Over.forget (sZ u)).map e) := ⟨l, hel, hl⟩
    haveI : IsIso e := isIso_of_reflects_iso e (Over.forget (sZ u))
    exact of_iso (asIso e).symm hΓ
  | @pullback Θ Γ₀ hΘ n v g h hpb₀ ih =>
    obtain ⟨E₁, ι₁, w₁, ⟨heq₁⟩⟩ :=
      exists_isLimit_fork_of_comp_eq (f₁ ≫ v).left (f₂ ≫ v).left Θ.hom
        (by rw [Over.w (f₁ ≫ v), Over.w (f₂ ≫ v)])
    let Γ₁ : Over (sZ u) := Over.mk (ι₁ ≫ Γ.hom)
    let e₁ : Γ₁ ⟶ Γ := Over.homMk ι₁ rfl
    have hΓ₁ : IsFamilyGat u Γ₁ := ih hΓ (f₁ ≫ v) (f₂ ≫ v) e₁ w₁ heq₁
    let σ : Γ₁.left ⟶ (iterP u n).obj Y := ι₁ ≫ f₁.left ≫ g
    let δ : Γ₁.left ⟶ (iterP u n).obj Y := ι₁ ≫ f₂.left ≫ g
    have hσδ : σ ≫ (iterP u n).map u = δ ≫ (iterP u n).map u := by
      dsimp [σ, δ]
      have w₁' : (ι₁ ≫ f₁.left) ≫ v.left = (ι₁ ≫ f₂.left) ≫ v.left := by
        simpa [Category.assoc] using w₁
      simp only [Category.assoc, hpb₀.w]
      exact (reassoc_of% w₁') h
    have hev : e.left ≫ (f₁ ≫ v).left = e.left ≫ (f₂ ≫ v).left := by
      change e.left ≫ f₁.left ≫ v.left = e.left ≫ f₂.left ≫ v.left
      rw [← Category.assoc, w, Category.assoc]
    let ⟨e₂, he₂⟩ := Fork.IsLimit.lift' heq₁ e.left hev
    change e₂ ≫ ι₁ = e.left at he₂
    have he₂_over : e₂ ≫ Γ₁.hom = Δ.hom := by
      change e₂ ≫ ι₁ ≫ Γ.hom = Δ.hom
      rw [← Category.assoc, he₂, Over.w e]
    have w₂ : e₂ ≫ σ = e₂ ≫ δ := by
      dsimp [σ, δ]
      rw [reassoc_of% he₂, reassoc_of% w, reassoc_of% he₂]
    have heq₂ : IsLimit (Fork.ofι e₂ w₂) := by
      refine Fork.IsLimit.mk' _ fun s => ?_
      have hs : (s.ι ≫ ι₁) ≫ f₁.left = (s.ι ≫ ι₁) ≫ f₂.left := by
        apply hpb₀.hom_ext
        · simpa [σ, δ, Category.assoc] using s.condition
        · have w₁' : ι₁ ≫ f₁.left ≫ v.left = ι₁ ≫ f₂.left ≫ v.left := w₁
          simp only [Category.assoc, w₁']
      let ⟨l, hl⟩ := Fork.IsLimit.lift' heq (s.ι ≫ ι₁) hs
      change l ≫ e.left = s.ι ≫ ι₁ at hl
      have hl' : (l : s.pt ⟶ Δ.left) ≫ e₂ = s.ι := by
        apply Fork.IsLimit.hom_ext heq₁
        change ((l : s.pt ⟶ Δ.left) ≫ e₂) ≫ ι₁ = s.ι ≫ ι₁
        rw [Category.assoc, he₂, hl]
      refine ⟨l, hl', fun {m} hm => ?_⟩
      let m' : s.pt ⟶ Δ.left := m
      let l' : s.pt ⟶ Δ.left := l
      have hm' : m' ≫ e₂ = s.ι := hm
      apply Fork.IsLimit.hom_ext heq
      change m' ≫ e.left = l' ≫ e.left
      rw [← he₂, ← Category.assoc, hm', ← Category.assoc, hl']
    exact IsFamilyGat.equalizer hΓ₁ n (Over.homMk e₂ he₂_over) σ δ hσδ w₂ heq₂
  | @equalizer Θ Γ₀ hΘ n v σ₀ δ₀ hσδ₀ w₀ heq₀ ih =>
    have w' : e.left ≫ (f₁ ≫ v).left = e.left ≫ (f₂ ≫ v).left := by
      change e.left ≫ f₁.left ≫ v.left = e.left ≫ f₂.left ≫ v.left
      rw [← Category.assoc, w, Category.assoc]
    have heq' : IsLimit (Fork.ofι e.left w') := by
      refine Fork.IsLimit.mk' _ fun s => ?_
      have hs : s.ι ≫ f₁.left = s.ι ≫ f₂.left := by
        apply Fork.IsLimit.hom_ext heq₀
        simpa [Category.assoc] using s.condition
      let ⟨l, hl⟩ := Fork.IsLimit.lift' heq s.ι hs
      exact ⟨l, hl, fun {m} hm => Fork.IsLimit.hom_ext heq (hm.trans hl.symm)⟩
    exact ih hΓ (f₁ ≫ v) (f₂ ≫ v) e w' heq'

/-- Family GATs are closed under equalisers in `Over (sZ u)`.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
theorem of_isLimit_fork {Γ₀ Γ Δ : Over (sZ u)} (hΓ₀ : IsFamilyGat u Γ₀) (hΓ : IsFamilyGat u Γ)
    {f₁ f₂ : Γ ⟶ Γ₀} {e : Δ ⟶ Γ} (w : e ≫ f₁ = e ≫ f₂) (heq : IsLimit (Fork.ofι e w)) :
    IsFamilyGat u Δ := by
  have w_left : e.left ≫ f₁.left = e.left ≫ f₂.left := congrArg CommaMorphism.left w
  refine of_isLimit_fork_left hΓ₀ hΓ f₁ f₂ e w_left (Fork.IsLimit.mk' _ fun s => ?_)
  let S : Over (sZ u) := Over.mk (s.ι ≫ Γ.hom)
  let s_over : S ⟶ Γ := Over.homMk s.ι rfl
  have hs_cond : s_over ≫ f₁ = s_over ≫ f₂ := Over.OverMorphism.ext s.condition
  let ⟨l, hl⟩ := Fork.IsLimit.lift' heq s_over hs_cond
  refine ⟨l.left, congrArg CommaMorphism.left hl, fun {m} hm => ?_⟩
  let m' : s.pt ⟶ Δ.left := m
  have hm' : m' ≫ e.left = s.ι := hm
  have hm_over : m' ≫ Δ.hom = S.hom := by
    change m' ≫ Δ.hom = s.ι ≫ Γ.hom
    rw [← Over.w e, ← Category.assoc, hm']
  have h_eq : Over.homMk m' hm_over = l := by
    apply Fork.IsLimit.hom_ext heq
    refine (Over.OverMorphism.ext hm').trans hl.symm
  exact congrArg CommaMorphism.left h_eq

/-- Family GATs are closed under pullbacks in `Over (sZ u)` (when the underlying square in `C` is
a pullback). -/
theorem of_isPullback_left {W X₁ X₂ S : Over (sZ u)} {fst : W ⟶ X₁} {snd : W ⟶ X₂}
    {f : X₁ ⟶ S} {g : X₂ ⟶ S} (hpb : IsPullback fst.left snd.left f.left g.left)
    (h₁ : IsFamilyGat u X₁) (h₂ : IsFamilyGat u X₂) (hS : IsFamilyGat u S) :
    IsFamilyGat u W := by
  let P : Over (sZ u) := Over.mk (pullback.fst X₁.hom X₂.hom ≫ X₁.hom)
  let p₁ : P ⟶ X₁ := Over.homMk (pullback.fst X₁.hom X₂.hom) rfl
  let p₂ : P ⟶ X₂ := Over.homMk (pullback.snd X₁.hom X₂.hom) pullback.condition.symm
  have hP : IsFamilyGat u P :=
    prod_over h₁ h₂ p₁ p₂ (IsPullback.of_hasPullback X₁.hom X₂.hom)
  let e_left : W.left ⟶ P.left :=
    pullback.lift fst.left snd.left ((Over.w fst).trans (Over.w snd).symm)
  have he_p₁ : e_left ≫ p₁.left = fst.left := pullback.lift_fst _ _ _
  have he_p₂ : e_left ≫ p₂.left = snd.left := pullback.lift_snd _ _ _
  have he_over : e_left ≫ P.hom = W.hom := by
    change e_left ≫ p₁.left ≫ X₁.hom = W.hom
    rw [← Category.assoc, he_p₁, Over.w fst]
  let e : W ⟶ P := Over.homMk e_left he_over
  have w : e.left ≫ (p₁ ≫ f).left = e.left ≫ (p₂ ≫ g).left := by
    change e_left ≫ p₁.left ≫ f.left = e_left ≫ p₂.left ≫ g.left
    rw [← Category.assoc, ← Category.assoc, he_p₁, he_p₂, hpb.w]
  refine of_isLimit_fork_left hS hP (p₁ ≫ f) (p₂ ≫ g) e w (Fork.IsLimit.mk' _ fun s => ?_)
  have hs : (s.ι ≫ p₁.left) ≫ f.left = (s.ι ≫ p₂.left) ≫ g.left := by
    simpa [Category.assoc] using s.condition
  let l : s.pt ⟶ W.left := hpb.lift (s.ι ≫ p₁.left) (s.ι ≫ p₂.left) hs
  have hl : l ≫ e.left = s.ι := by
    apply pullback.hom_ext
    · change (l ≫ e_left) ≫ p₁.left = s.ι ≫ p₁.left
      rw [Category.assoc, he_p₁, hpb.lift_fst]
    · change (l ≫ e_left) ≫ p₂.left = s.ι ≫ p₂.left
      rw [Category.assoc, he_p₂, hpb.lift_snd]
  refine ⟨l, hl, fun {m} hm => ?_⟩
  let m' : s.pt ⟶ W.left := m
  have hm' : m' ≫ e_left = s.ι := hm
  apply hpb.hom_ext
  · rw [hpb.lift_fst, ← hm', Category.assoc, he_p₁]
  · rw [hpb.lift_snd, ← hm', Category.assoc, he_p₂]

/-- Family GATs are closed under pullbacks in `Over (sZ u)`.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
theorem of_isPullback {W X₁ X₂ S : Over (sZ u)} {fst : W ⟶ X₁} {snd : W ⟶ X₂}
    {f : X₁ ⟶ S} {g : X₂ ⟶ S} (hpb : IsPullback fst snd f g)
    (h₁ : IsFamilyGat u X₁) (h₂ : IsFamilyGat u X₂) (hS : IsFamilyGat u S) :
    IsFamilyGat u W :=
  of_isPullback_left ((Over.forget (sZ u)).map_isPullback hpb) h₁ h₂ hS

end IsFamilyGat

end Limits

end SliceExp

namespace Lexp

open SliceExp

/-- The predicate of being a **family GAT** in the slice `Lexp`-category `Φ.obj A = A / P X` of a
`Lexp`-category `A`.

[Paper, §3.2, Def. of family GATs]. -/
def IsFamilyGat (A : Lexp.{v, max u v}) : (Φ.obj A).carrier → Prop :=
  SliceExp.IsFamilyGat A.arr

/-- **Proposition `prop:family-gats`**: in `Φ.obj A = A / P X`, `(A : U, a : El A)_Fam` and
`(A : U)_Fam` are family GATs, and family GATs are closed under isomorphisms, the terminal object,
pullbacks, and pushforwards along `(A : U, a : El A)_Fam ⟶ (A : U)_Fam`.

[Paper, §3.2, Prop. `prop:family-gats`] and [Paper, App. A.2]. -/
theorem isFamilyGat_inductive (A : Lexp.{v, max u v}) :
    InductiveProperty (Φ.obj A) (IsFamilyGat A) where
  of_iso e h := SliceExp.IsFamilyGat.of_iso e h
  terminal := SliceExp.IsFamilyGat.terminal
  pullback hpb h₁ h₂ hS := SliceExp.IsFamilyGat.of_isPullback hpb h₁ h₂ hS
  exp _ hc := SliceExp.IsFamilyGat.exp hc
  dom := SliceExp.IsFamilyGat.dom
  cod := SliceExp.IsFamilyGat.cod

/-- The full subcategory of `Φ.obj A = A / P X` spanned by family GATs, equipped with the induced
`Lexp`-structure.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
noncomputable def FamGat (A : Lexp.{v, max u v}) : Lexp.{v, max u v} :=
  (isFamilyGat_inductive A).subExp

/-- The inclusion of the full subcategory of family GATs `FamGat A ↪ Φ.obj A`, as a morphism of
`Lexp` (preserving finite limits, the exponentiable arrow, and pushforwards along it).

[Paper, §3.2, Prop. `prop:family-gats`]. -/
noncomputable def famGatHom (A : Lexp.{v, max u v}) : FamGat A ⟶ Φ.obj A :=
  (isFamilyGat_inductive A).ιHom

section FiniteLimits

variable (A : Lexp.{v, max u v})

noncomputable instance : HasFiniteLimits ((isFamilyGat_inductive A).prop).FullSubcategory :=
  hasFiniteLimits_of_hasTerminal_and_pullbacks

noncomputable instance : PreservesFiniteLimits ((isFamilyGat_inductive A).prop).ι :=
  preservesFiniteLimits_of_preservesTerminal_and_pullbacks ((isFamilyGat_inductive A).prop).ι

/-- Family GATs are closed under all finite limits in `Φ.obj A = A / P X`.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
instance isClosedUnderFiniteLimits (J : Type) [SmallCategory J] [FinCategory J] :
    ((isFamilyGat_inductive A).prop).IsClosedUnderLimitsOfShape J :=
  ObjectProperty.isClosedUnderLimitsOfShape_of_preservesLimitsOfShape_ι
    (isFamilyGat_inductive A).prop J

/-- Any limit cone in `Φ.obj A = A / P X` of a finite diagram of family GATs has a family GAT as
its apex.

[Paper, §3.2, Prop. `prop:family-gats`]. -/
theorem IsFamilyGat.of_isLimit_finite {J : Type} [SmallCategory J] [FinCategory J]
    {F : J ⥤ (Φ.obj A).carrier} {c : Cone F} (hc : IsLimit c)
    (hF : ∀ j : J, IsFamilyGat A (F.obj j)) : IsFamilyGat A c.pt :=
  ((isFamilyGat_inductive A).prop).prop_of_isLimit hc hF

end FiniteLimits

section Soundness

variable {FinGat : Lexp.{v, max u v}} (hFinGat : IsBiInitial FinGat)

/-- By bi-initiality of `FinGat`, the two-sortification functor `FinGat ⟶ Φ.obj FinGat` is
isomorphic to the composition of a `Lexp`-morphism `FinGat ⟶ FamGat FinGat` into the full
subcategory of family GATs with the embedding `famGatHom FinGat : FamGat FinGat ⟶ Φ.obj FinGat`.

[Paper, §3.2, proof of the Corollary after Prop. `prop:family-gats`]. -/
theorem exists_hom_famGat_iso_twoSortification :
    ∃ S : FinGat ⟶ FamGat FinGat,
      Nonempty (S ≫ famGatHom FinGat ≅ twoSortification hFinGat) :=
  let S := hFinGat.strictHom (FamGat FinGat)
  ⟨S, hFinGat.nonempty_iso (S ≫ famGatHom FinGat) (twoSortification hFinGat)⟩

/-- **Soundness of two-sortification (up to isomorphism)**: the image of any GAT `Γ` under the
two-sortification functor is isomorphic to a family GAT.

[Paper, §3.2, Corollary after Prop. `prop:family-gats`]. -/
theorem exists_isFamilyGat_iso_twoSortification (Γ : FinGat.carrier) :
    ∃ Δ : (Φ.obj FinGat).carrier,
      IsFamilyGat FinGat Δ ∧ Nonempty ((twoSortification hFinGat).functor.obj Γ ≅ Δ) := by
  obtain ⟨S, ⟨e⟩⟩ := exists_hom_famGat_iso_twoSortification hFinGat
  refine ⟨(S.functor.obj Γ).obj, (S.functor.obj Γ).property, ⟨?_⟩⟩
  exact
    { hom := e.inv.nat.app Γ
      inv := e.hom.nat.app Γ
      hom_inv_id := congrArg (fun t => t.nat.app Γ) e.inv_hom_id
      inv_hom_id := congrArg (fun t => t.nat.app Γ) e.hom_inv_id }

/-- **Soundness of two-sortification**: the image of any GAT `Γ` under the two-sortification
functor is a family GAT.

[Paper, §3.2, Corollary after Prop. `prop:family-gats`]. -/
theorem twoSortification_isFamilyGat (Γ : FinGat.carrier) :
    IsFamilyGat FinGat ((twoSortification hFinGat).functor.obj Γ) := by
  obtain ⟨Δ, hΔ, ⟨e⟩⟩ := exists_isFamilyGat_iso_twoSortification hFinGat Γ
  exact SliceExp.IsFamilyGat.of_iso e.symm hΔ

end Soundness

end Lexp
